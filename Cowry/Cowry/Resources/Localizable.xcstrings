{
  "sourceLanguage": "en",
  "strings": {
    "%@ + %lld more": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 외 %lld"
          }
        }
      }
    },
    "%@ has accounts under it. Move or delete them first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 아래에 계정이 있어요. 먼저 옮기거나 지우세요."
          }
        }
      }
    },
    "%@ has balance checks. Remove them first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 잔액 확인 기록이 있어요. 먼저 지우세요."
          }
        }
      }
    },
    "%@ has transactions after %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 %2$@ 이후 거래가 있어요."
          }
        }
      }
    },
    "%@ has transactions. Stop using it, or merge it into another account.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 거래가 있어요. 사용을 종료하거나 다른 계정에 합치세요."
          }
        }
      }
    },
    "%@ is hidden or no longer in use.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 계정은 숨겨졌거나 사용이 종료됐어요."
          }
        }
      }
    },
    "%@ is hidden. Show it again to use it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 통화가 숨겨져 있어요. 다시 보이게 해야 쓸 수 있어요."
          }
        }
      }
    },
    "%@ isn’t in use on %@. Change the date or choose another account.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 계정은 %2$@에 사용 중이 아니에요. 날짜를 바꾸거나 다른 계정을 고르세요."
          }
        }
      }
    },
